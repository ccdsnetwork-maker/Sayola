        formData.get("hireDate") || ""
      ).trim();

      const hireDaysValue = String(
        formData.get("hireDays") || ""
      ).trim();

      const message = String(
        formData.get("message") || ""
      ).trim();

      const parsedHireDays = Number(hireDaysValue);

      if (
        !hireDate ||
        !hireDaysValue ||
        !Number.isInteger(parsedHireDays) ||
        parsedHireDays < 1 ||
        !message
      ) {
        setError(
          "Please enter a hire date, a valid number of days and your additional information."
        );
        return;
      }

      if (!selectedCarId || !selectedCar) {
        setError("Please select an available car.");
        return;
