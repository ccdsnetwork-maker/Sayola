                      {/* AVAILABLE CARS */}
                      <div>
                        <div className="flex items-center gap-2">
                          <Car
                            size={20}
                            className="text-[#FF6B00]"
                          />

                          <h3 className="font-extrabold text-[#0A2342]">
                            Available Cars for Hire
                          </h3>
                        </div>

                        <p className="mt-2 text-sm leading-6 text-slate-500">
                          Choose from the vehicles currently available for hire.
                          The price shown is the daily hire rate.
                        </p>

                        {loadingCars ? (
                          <div className="mt-5 rounded-xl bg-[#F4F6F9] p-5 text-center">
                            <p className="text-sm font-semibold text-slate-500">
                              Loading available cars...
                            </p>
                          </div>
                        ) : cars.length === 0 ? (
                          <div className="mt-5 rounded-xl border border-amber-200 bg-amber-50 p-5">
                            <p className="text-sm font-semibold text-amber-800">
                              There are currently no cars available for hire.
                              Please contact us for assistance.
                            </p>
                          </div>
                        ) : (
                          <div className="mt-5 grid gap-5 sm:grid-cols-2">
                            {cars.map((car) => (
                              <button
                                key={car.id}
                                type="button"
                                onClick={() => {
                                  setSelectedCarId(car.id);
                                }}
                                className={`overflow-hidden rounded-2xl border text-left transition ${
                                  selectedCarId === car.id
                                    ? "border-[#FF6B00] ring-2 ring-[#FF6B00]/20"
                                    : "border-slate-200 hover:border-[#FF6B00]/50"
                                }`}
                              >
                                {car.imageUrl ? (
                                  <div className="h-44 w-full overflow-hidden bg-slate-100">
                                    <img
                                      src={car.imageUrl}
                                      alt={car.name}
                                      className="h-full w-full object-cover"
                                    />
                                  </div>
                                ) : (
                                  <div className="flex h-44 items-center justify-center bg-[#F4F6F9]">
                                    <Car
                                      size={50}
                                      className="text-slate-300"
                                    />
                                  </div>
                                )}

                                <div className="p-5">
                                  <div className="flex items-start justify-between gap-3">
                                    <div>
                                      <h4 className="font-extrabold text-[#0A2342]">
                                        {car.name}
                                      </h4>

                                      {(car.brand || car.model) && (
                                        <p className="mt-1 text-xs font-semibold text-slate-500">
                                          {[car.brand, car.model]
                                            .filter(Boolean)
                                            .join(" ")}
                                          {car.year
                                            ? ` • ${car.year}`
                                            : ""}
                                        </p>
                                      )}
                                    </div>

                                    {selectedCarId === car.id && (
                                      <span className="shrink-0 rounded-lg bg-[#FF6B00]/10 px-2.5 py-1 text-xs font-extrabold text-[#FF6B00]">
                                        Selected
                                      </span>
                                    )}
                                  </div>

                                  {car.description && (
                                    <p className="mt-3 text-sm leading-6 text-slate-500">
                                      {car.description}
                                    </p>
                                  )}

                                  <p className="mt-4 text-lg font-extrabold text-[#0A2342]">
                                    ₦{car.pricePerDay.toLocaleString()}
                                    <span className="ml-1 text-xs font-semibold text-slate-500">
                                      / day
                                    </span>
                                  </p>
                                </div>
                              </button>
                            ))}
                          </div>
                        )}
                      </div>

                      {/* SELECTED CAR */}
                      {selectedCar && (
                        <div className="rounded-2xl bg-[#0A2342] p-5 text-white">
                          <p className="text-xs font-bold uppercase tracking-[0.18em] text-[#FF6B00]">
                            Selected Vehicle
                          </p>

                          <div className="mt-2 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                              <h4 className="text-xl font-extrabold">
                                {selectedCar.name}
                              </h4>

                              <p className="text-sm text-slate-300">
                                ₦{selectedCar.pricePerDay.toLocaleString()} per day
                              </p>
                            </div>

                            <button
                              type="button"
                              onClick={() => setSelectedCarId("")}
                              className="self-start text-sm font-bold text-[#FF6B00] hover:text-white"
                            >
                              Change Car
                            </button>
                          </div>
                        </div>
                      )}

                      {/* HIRE DETAILS */}

                      <div className="grid gap-5 sm:grid-cols-2">

                        <div>
                          <label
                            htmlFor="hireDate"
                            className="mb-2 block text-sm font-bold text-[#0A2342]"
                          >
                            Hire Date *
                          </label>

                          <input
                            id="hireDate"
                            name="hireDate"
                            required
                            type="date"
                            className="w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[#FF6B00] focus:ring-2 focus:ring-[#FF6B00]/10"
                          />
                        </div>

                        <div>
                          <label
                            htmlFor="hireTime"
                            className="mb-2 block text-sm font-bold text-[#0A2342]"
                          >
                            Preferred Time *
                          </label>

                          <input
                            id="hireTime"
                            name="hireTime"
                            required
                            type="time"
                            className="w-full rounded-xl border border-slate-200 bg-white px-4 py-3.5 text-sm outline-none transition focus:border-[#FF6B00] focus:ring-2 focus:ring-[#FF6B00]/10"
                          />
                        </div>

                      </div>

                      {/* NUMBER OF DAYS */}
                      <div>
                        <label
                          htmlFor="hireDays"
                          className="mb-2 block text-sm font-bold text-[#0A2342]"
                        >
                          Number of Days *
                        </label>

                        <input
                          id="hireDays"
                          name="hireDays"
                          required
                          type="number"
                          min="1"
                          step="1"
                          inputMode="numeric"
                          value={hireDaysNumber}
                          onChange={(event) => {
                            const value = event.target.value;

                            if (value === "" || /^\d+$/.test(value)) {
                              setHireDays(value);
                            }
                          }}
                          placeholder="Enter number of days"
                          className="w-full rounded-xl border border-slate-200 px-4 py-3.5 text-sm outline-none transition focus:border-[#FF6B00] focus:ring-2 focus:ring-[#FF6B00]/10"
                        />

                        <p className="mt-2 text-xs text-slate-500">
                          Enter the number of days you want to rent the vehicle.
                        </p>
                      </div>

                      {/* LIVE PRICE */}
                      {selectedCar && (
                        <div className="rounded-2xl border border-[#FF6B00]/20 bg-[#FF6B00]/5 p-5">

                          <div className="flex items-center justify-between gap-4">
                            <span className="text-sm font-semibold text-slate-600">
                              Daily rate
                            </span>

                            <span className="font-bold text-[#0A2342]">
                              ₦{selectedCar.pricePerDay.toLocaleString()}
                            </span>
                          </div>

                          <div className="mt-3 flex items-center justify-between gap-4">
                            <span className="text-sm font-semibold text-slate-600">
                              Number of days
                            </span>

                            <span className="font-bold text-[#0A2342]">
                              {hireDays}
                            </span>
                          </div>

                          <div className="my-4 border-t border-[#FF6B00]/20" />

                          <div className="flex items-center justify-between gap-4">
                            <span className="text-base font-extrabold text-[#0A2342]">
                              Estimated Hire Total
                            </span>

                            <span className="text-2xl font-extrabold text-[#FF6B00]">
                              ₦{hireTotal.toLocaleString()}
                            </span>
                          </div>

                          <p className="mt-3 text-xs leading-5 text-slate-500">
                            This is an estimated vehicle hire amount based
                            on the selected daily rate and number of days.
                            Any additional approved charges will be handled
                            separately by our team.
                          </p>

                        </div>
                      )}

                      {/* ADDITIONAL INFORMATION */}
                      <div>
                        <label
                          htmlFor="message"
                          className="mb-2 block text-sm font-bold text-[#0A2342]"
                        >
                          Additional Information *
                        </label>

                        <textarea
                          id="message"
                          name="message"
                          required
                          rows={4}
                          placeholder="Tell us anything else we should know about your hire..."
                          className="w-full resize-none rounded-xl border border-slate-200 px-4 py-3.5 text-sm outline-none transition focus:border-[#FF6B00] focus:ring-2 focus:ring-[#FF6B00]/10"
                        />
                      </div>

                    </div>
                  )}

                  <button
                    type="submit"
                    disabled={sending || !service}
                    className="flex w-full items-center justify-center gap-2 rounded-xl bg-[#FF6B00] px-6 py-4 font-bold text-white transition hover:bg-[#e85f00] disabled:cursor-not-allowed disabled:opacity-60"
                  >
                    {sending
                      ? "Submitting Request..."
                      : "Submit Request"}

                    {!sending && <Send size={18} />}
                  </button>
                </form>
              </div>
            </Reveal>
          </div>
        </div>
      </section>

      {/* PROCESS */}
      <section className="bg-white py-20 sm:py-24">
        <div className="container-site">
          <Reveal>
            <div className="mx-auto max-w-2xl text-center">
              <p className="text-sm font-bold uppercase tracking-[0.2em] text-[#FF6B00]">
                How It Works
              </p>

              <h2 className="mt-4 text-3xl font-extrabold text-[#0A2342] sm:text-4xl">
                Simple, professional and focused.
              </h2>

              <p className="mt-4 leading-7 text-slate-600">
                We keep the request process straightforward so
                you can focus on your needs while we handle the
                details.
              </p>
            </div>
          </Reveal>

          <div className="mt-12 grid gap-6 md:grid-cols-3">
            {process.map((step, index) => {
              const Icon = step.icon;

              return (
                <Reveal
                  key={step.number}
                  delay={index * 0.1}
                >
                  <motion.div
                    whileHover={{ y: -5 }}
                    className="relative rounded-2xl border border-slate-100 bg-[#F4F6F9] p-7"
                  >
                    <div className="flex items-center justify-between">
                      <div className="flex h-12 w-12 items-center justify-center rounded-xl bg-[#FF6B00] text-white">
                        <Icon size={23} />
                      </div>

                      <span className="text-3xl font-extrabold text-[#0A2342]/10">
                        {step.number}
                      </span>
                    </div>

                    <h3 className="mt-7 text-xl font-extrabold text-[#0A2342]">
                      {step.title}
                    </h3>

                    <p className="mt-3 text-sm leading-7 text-slate-500">
                      {step.description}
                    </p>
                  </motion.div>
                </Reveal>
              );
            })}
          </div>
        </div>
      </section>

      {/* CTA */}
      <section className="bg-[#0A2342] py-20 sm:py-24">
        <div className="container-site">
          <Reveal>
            <div className="mx-auto max-w-3xl text-center">
              <MapPin
                size={32}
                className="mx-auto text-[#FF6B00]"
              />

              <h2 className="mt-5 text-3xl font-extrabold text-white sm:text-4xl">
                Need transportation or logistics support?
              </h2>

              <p className="mx-auto mt-4 max-w-2xl leading-7 text-slate-300">
                Submit your request and let our team work out the
                right solution for you.
              </p>

              <a
                href="#request"
                className="mt-7 inline-flex items-center gap-2 rounded-xl bg-[#FF6B00] px-7 py-4 font-bold text-white transition hover:bg-[#e85f00]"
              >
                Make a Request
                <ArrowRight size={18} />
              </a>
            </div>
          </Reveal>
        </div>
      </section>
    </main>
  );
}
