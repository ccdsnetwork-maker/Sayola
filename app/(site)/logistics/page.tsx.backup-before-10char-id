    const name = String(formData.get("name") || "").trim();
    const phone = String(formData.get("phone") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const selectedService = String(
      formData.get("service") || ""
    ).trim();

    if (!name || !phone || !email || !selectedService) {
      setError("Please complete all required fields.");
      return;
    }

    let requestData: Record<string, string | number> = {
      name,
      phone,
      email,
      service: selectedService,
    };

    if (selectedService === "haulage") {
      const pickup = String(formData.get("pickup") || "").trim();
      const destination = String(
        formData.get("destination") || ""
      ).trim();
      const goods = String(formData.get("goods") || "").trim();
      const vehicleType = String(
        formData.get("vehicleType") || ""
      ).trim();
      const message = String(
        formData.get("message") || ""
      ).trim();

      if (
        !pickup ||
        !destination ||
        !goods ||
        !vehicleType ||
        !message
      ) {
        setError("Please complete all haulage request fields.");
        return;
      }

      requestData = {
        ...requestData,
        pickup,
        destination,
        goods,
        vehicleType,
        message,
      };
    }

    if (selectedService === "logistics") {
      const pickup = String(formData.get("pickup") || "").trim();
      const destination = String(
        formData.get("destination") || ""
      ).trim();
      const logisticsType = String(
        formData.get("logisticsType") || ""
      ).trim();
      const goods = String(formData.get("goods") || "").trim();
      const message = String(
        formData.get("message") || ""
      ).trim();

      if (
        !pickup ||
        !destination ||
        !logisticsType ||
        !goods ||
        !message
      ) {
        setError(
          "Please complete all logistics request fields."
        );
        return;
      }

      requestData = {
        ...requestData,
        pickup,
        destination,
        logisticsType,
        goods,
        message,
      };
