  const [selectedCarId, setSelectedCarId] = useState("");
  const [hireDays, setHireDays] = useState("");

  async function loadLogisticsCars() {
    try {
      setLoadingCars(true);

      const snapshot = await getDocs(collection(db, "logisticsCars"));

      const loadedCars: LogisticsCar[] = snapshot.docs
        .map((doc) => {
          const data = doc.data();

          return {
            id: doc.id,
            name: String(data.name || ""),
            brand: data.brand ? String(data.brand) : "",
            model: data.model ? String(data.model) : "",
            year: data.year ? String(data.year) : "",
            description: data.description
              ? String(data.description)
              : "",
            imageUrl: data.imageUrl
              ? String(data.imageUrl)
              : "",
            pricePerDay: Number(data.pricePerDay || 0),
            available:
              data.available === undefined
                ? true
                : Boolean(data.available),
          };
        })
        .filter((car) => car.available);

      setCars(loadedCars);
    } catch (error) {
      console.error("LOAD LOGISTICS CARS ERROR:", error);
      setError(
        "We could not load the available hire cars. Please try again later."
      );
    } finally {
      setLoadingCars(false);
    }
