      await addDoc(collection(db, "messages"), {
        trackingId,
        requestId: trackingId,
        type: "logistics_request",

        ...requestData,

        status: "Pending",
        read: false,
        createdAt: serverTimestamp(),
        updatedAt: serverTimestamp(),
